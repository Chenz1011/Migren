# ========================================================================
# MIGREN — NIMORI sniper on Pons / Robinhood Chain
# Copy ini ke `.env` lalu isi value-nya.
# ========================================================================

# -------- WALLET --------
# Private key dari wallet lu (0x-prefixed, 64 hex chars).
# WAJIB. Ini yang nandatangani tx. JANGAN pernah commit .env ke git.
PRIVATE_KEY=0x_isi_private_key_lu_disini

# -------- RPC --------
# Robinhood Chain mainnet. Public RPC udah di-pre-fill tapi lebih bagus
# pakai dedicated endpoint (QuickNode / Chainstack / Dwellir / dRPC) biar
# ga di-ratelimit pas pingin kenceng.
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
# WebSocket WAJIB untuk subscribe log real-time. Kalo endpoint lu ga punya
# WS, kasih kosong — bot akan fallback ke polling (lebih lambat).
RPC_WS_URL=

# -------- TARGET --------
# Ticker yang mau di-snipe. Case-insensitive, exact match.
TARGET_TICKER=NIMORI

# Kalo lu udah tau address NIMORI yang di-deploy, isi di sini supaya skip
# discovery dan langsung monitoring. Kalo belum tau, biarkan kosong — bot
# bakal auto-discover lewat Pons factory.
TARGET_TOKEN_ADDRESS=

# -------- BUY SIZE --------
# Jumlah ETH per snipe (bukan wei; contoh 0.05 artinya 0.05 ETH).
BUY_SIZE_ETH=0.05

# Max slippage dalam basis points (100 = 1%). Hati-hati, kalo kekecilan
# tx bisa revert pas volatile.
MAX_SLIPPAGE_BPS=1500

# -------- GAS --------
# Priority fee tip dalam gwei. Robinhood Chain block time ~0.1s jadi
# priority ga sepenting mainnet, tapi tetep kasih buffer.
PRIORITY_FEE_GWEI=0.5
# Max fee per gas cap dalam gwei. Protect dari gas spike.
MAX_FEE_GWEI=5

# -------- TRIGGERS --------
# Trigger 1: snipe pas NIMORI graduate dari bonding curve ke Uniswap V4.
TRIGGER_ON_MIGRATION=true

# Trigger 2: snipe pas volume spike. Threshold dalam ETH per window.
TRIGGER_ON_VOLUME_SPIKE=true
VOLUME_WINDOW_SECONDS=60
VOLUME_SPIKE_ETH=1.0

# -------- SAFETY --------
# DRY_RUN=true → bot cuma log apa yang bakal dilakukan tanpa submit tx.
# WAJIB test dulu DRY_RUN=true sebelum pakai duit beneran.
DRY_RUN=true

# Max total ETH yang boleh di-spend selama bot jalan. Fail-safe kalo ada
# trigger kebakaran berulang.
MAX_TOTAL_SPEND_ETH=0.5

# -------- CONTRACTS (Pons V2 on Robinhood Chain) --------
# Default-nya udah bener per 2026-10, hanya ganti kalo Pons re-deploy.
PONS_LAUNCH_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_LAUNCH_AND_BUY=0xe33e9e479df8802cb0866d5d05258bec4cf62948
PONS_MEME_HOOK=0xe5e702641ea86f4ae6cc3cdaed2b886f976be044

# Uniswap V4 PoolManager di Robinhood Chain. Kalo ga tau, isi 0x0 — bot
# akan fallback deteksi graduation lewat hook/factory saja.
UNISWAP_V4_POOL_MANAGER=0x0000000000000000000000000000000000000000

# Universal Router (buat buy post-graduation). Isi kalo lu udah tau.
UNIVERSAL_ROUTER=0x0000000000000000000000000000000000000000

# Native wrapped ETH (WETH) di Robinhood Chain. Diperlukan untuk encode
# swap path. Isi kalo tau, kalo ga biarkan 0x0 (bot akan skip post-grad swap).
WETH_ADDRESS=0x0000000000000000000000000000000000000000

# -------- GMGN (opsional) --------
# Kalo mau pakai GMGN sebagai fallback execution route. Default: tidak dipakai.
GMGN_ENABLED=false
GMGN_API_KEY=
GMGN_BASE_URL=https://gmgn.ai/defi/router/v1

# -------- LOGGING --------
LOG_LEVEL=info
