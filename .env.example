# ========================================================================
# MIGREN — NIMORI sniper on Pons / Robinhood Chain
#
# QUICK FILL:
#   1. PRIVATE_KEY       — priv key wallet buat snipe (0x + 64 hex)
#   2. GMGN_API_KEY      — API key GMGN lu
#   3. TELEGRAM_BOT_TOKEN — token bot TG (dari @BotFather)
#   4. TELEGRAM_CHAT_ID  — chat ID lu (dari @userinfobot)
#   5. (opsional) RPC_WS_URL — WebSocket RPC utk latency rendah
#
# Yang lain udah di-set default — ganti kalo lu mau tweaking.
# ========================================================================

# -------- WALLET --------
PRIVATE_KEY=0x_isi_private_key_lu_disini

# -------- EXECUTION ROUTE --------
# GMGN = fastest route via GMGN router (recommended).
# DIRECT = raw on-chain via Pons/UniV4 (fallback, butuh ngisi UNIVERSAL_ROUTER dkk).
EXECUTION_ROUTE=GMGN

# -------- GMGN --------
GMGN_API_KEY=
GMGN_CHAIN=robinhood
# Anti-MEV routing. true = lebih aman dari sandwich, false = sedikit lebih cepat.
GMGN_ANTI_MEV=true
# Auto-slippage ngikut recommendation GMGN. Kalo false, pake MAX_SLIPPAGE_BPS manual.
GMGN_AUTO_SLIPPAGE=true

# -------- RPC (buat monitoring events, bukan execution) --------
RPC_HTTP_URL=https://rpc.mainnet.chain.robinhood.com
RPC_WS_URL=

# -------- TARGET --------
TARGET_TICKER=NIMORI
TARGET_TOKEN_ADDRESS=

# -------- SIZE & SAFETY --------
BUY_SIZE_ETH=0.075
MAX_SLIPPAGE_BPS=1500
DRY_RUN=true
MAX_TOTAL_SPEND_ETH=0.5

# -------- GAS (buat direct route; GMGN auto-handle) --------
PRIORITY_FEE_GWEI=0.5
MAX_FEE_GWEI=5

# -------- TRIGGERS --------
TRIGGER_ON_MIGRATION=true
TRIGGER_ON_VOLUME_SPIKE=true

# Volume threshold dalam USD. Default 12,500 USD per window.
VOLUME_SPIKE_USD=12500
VOLUME_WINDOW_SECONDS=60

# -------- TELEGRAM NOTIF --------
# Bot token dari @BotFather. Chat ID dari @userinfobot (kirim /start ke dia).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFY_ON_DISCOVERY=true
TELEGRAM_NOTIFY_ON_TRIGGER=true
TELEGRAM_NOTIFY_ON_EXECUTE=true

# -------- CONTRACTS (Pons V2 on Robinhood Chain, per 2026-10) --------
PONS_LAUNCH_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
PONS_LAUNCH_AND_BUY=0xe33e9e479df8802cb0866d5d05258bec4cf62948
PONS_MEME_HOOK=0xe5e702641ea86f4ae6cc3cdaed2b886f976be044

# Buat DIRECT route (abaikan kalo pake GMGN):
UNISWAP_V4_POOL_MANAGER=0x0000000000000000000000000000000000000000
UNIVERSAL_ROUTER=0x0000000000000000000000000000000000000000
WETH_ADDRESS=0x0000000000000000000000000000000000000000

# -------- PRICE ORACLE (buat convert ETH->USD) --------
# Pake Coingecko public (no key needed). Ganti kalo lu punya key private.
PRICE_SOURCE_URL=https://api.coingecko.com/api/v3/simple/price?ids=ethereum&vs_currencies=usd
PRICE_REFRESH_SECONDS=120

# -------- LOGGING --------
LOG_LEVEL=info
